# Copy to .env (which is gitignored) and fill in. Never commit real values.

# Tradier market-data token. Without it tape.py reconstructs the day from the
# ledger and the brief carries series: [], directionality: null — i.e. no regime
# read at all. Read-only sandbox or production token both work.
#   scripts/tape.py, scripts/intraday_read.py
TRADIER_TOKEN=

# Optional. Defaults to https://api.tradier.com; point at
# https://sandbox.tradier.com to use a sandbox token.
TRADIER_BASE=

# The data cutover (build-plan.md §3). build_ledger.py carries a default and
# refuses to run without one; set this only to override for a backfill.
#   LEDGER_START=2026-08-10
LEDGER_START=

# Set to 1 to let lessons.py drop pre-cutover lesson rows. Left unset on purpose:
# truncating the 33 v1 rows is an archive decision, not a script default.
LESSONS_ALLOW_TRUNCATE=
