# Credentials & secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*_token*
*_secret*
secrets/
credentials/

# Database & binary files
*.db
*.sqlite
*.sqlite3
*.csv
*.xlsx
*.xls

# ...but DO track the data/ ledger + source-of-truth CSVs (trades.csv etc.)
!data/**/*.csv

# OS & editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Logs (raw; session-log.md is intentionally tracked)
*.log
.claude/

# Node (scripts/oa-driver — playwright-core is installed locally, never committed)
node_modules/
package-lock.json

# Playwright traces (evidence artifacts; large, regenerable, kept out of git)
data/receipts/traces/

# Lock-file quarantine (stranded .git lock artifacts; never committed)
_locktrash/
